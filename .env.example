# Скопируйте этот файл в .env и подставьте значения
# Telegram BotFather токен
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# OpenAI API ключ (аккаунт ChatGPT через OpenAI API)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Необязательно: модель
OPENAI_MODEL=gpt-4o-mini

# Путь к SQLite БД
DATABASE_PATH=/workspace/bot.db

# Час (0-23), когда бот вечером спрашивает сожженные калории
NOTIFY_HOUR=21

# Час (0-23), когда бот утром спрашивает часы сна
SLEEP_NOTIFY_HOUR=10

BOT_TOKEN=123456:PUT-YOUR-REAL-TOKEN-HERE